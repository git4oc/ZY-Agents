# ===========================================================================
# ZY-Agents · 环境变量模板
# ---------------------------------------------------------------------------
# 拷贝为 .env 填真实值。所有键必须与 services/api/app/settings.py 的 Settings
# 字段一一对应（由 scripts/check_settings_sync.py 强制一致）。
#
# 本模板为「裸进程 + 本地服务」形态（无 Docker）：主服务 uvicorn 跑 127.0.0.1:8000、
# 内核宿主 node 跑 127.0.0.1:8101、mongo/redis 按需本地启动。键名与 01 §6 完全一致，
# 仅把容器 DNS 名替换为 localhost 端口。
# ===========================================================================

# ---- 基础 ----
APP_ENV=development
# APP_BASE_URL 是主服务（uvicorn:8000）对外根地址：kernel 双凭证的 gateway_url
# 回调根（宿主侧 GatewayClient 自拼 /internal/kernel/{model/generate,tools/execute}）
APP_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# ---- Mongo（裸进程：本地 mongod 默认端口）----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=zy_agents

# ---- Redis（裸进程：本地 redis-server 默认端口）----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- 登录态 ----
JWT_SIGNING_SECRET=                      # bootstrap 生成
JWT_ISSUER=zy-agents
ACCESS_TOKEN_TTL_SECONDS=3600

# ---- 内核宿主（裸进程：node src/host.mjs 监听 8101）----
KERNEL_HOST_URL=http://127.0.0.1:8101
KERNEL_HOST_TOKEN=                       # bootstrap 生成，宿主与主服务共享
KERNEL_HEALTH_TIMEOUT_MS=3000

# ---- 双网关自指（下发给内核的回调地址，指向主服务 uvicorn:8000）----
KERNEL_MODEL_GATEWAY_URL=http://127.0.0.1:8000/internal/kernel/model/generate
KERNEL_TOOL_GATEWAY_URL=http://127.0.0.1:8000/internal/kernel/tools

# ---- 双网关签名密钥（域分离：工具网关内部自动加 "tool:" 前缀）----
KERNEL_MODEL_GATEWAY_SECRET=             # bootstrap 生成
KERNEL_TOOL_GATEWAY_SECRET=              # bootstrap 生成
GATEWAY_TOKEN_TTL_SECONDS=900

# ---- 文件与签名 URL ----
STORAGE_ROOT=./data/storage
ARTIFACT_URL_SECRET=                     # bootstrap 生成
ARTIFACT_URL_TTL_SECONDS=3600

# ---- 本地 Agent ----
LOCALAGENT_ENABLED=true
LOCALAGENT_MINIMUM_VERSION=0.1.0
LOCALAGENT_TICKET_TTL_SECONDS=60
LOCALAGENT_ACTION_TIMEOUT_MS=120000

# ---- 知识库（阶段 2）----
KNOWLEDGE_ENABLED=false
KNOWLEDGE_BIGRAM_FALLBACK_MAX_QUERY_CHARS=4

# ---- 配额（默认值，可按组织单元覆盖）----
DEFAULT_MODEL_TOKEN_QUOTA_MONTHLY=0      # 0 = 不限

# ---- 品牌与白标（00 §12）----
BRANDING_SEED_FILE=                      # 可选：部署预置品牌文件（YAML/JSON）；仅空库时 seed，幂等
BRANDING_ASSET_MAX_BYTES=1048576         # 单个 logo / favicon 字节上限（1 MiB）
BRANDING_ASSET_MAX_PIXELS=4096           # 单边像素上限（防解压炸弹）

# ---- 模型提供商转发（#13）----
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_MODEL=
MODEL_PROVIDER_MAX_CONTEXT_TOKENS=262144
MODEL_PROVIDER_MAX_OUTPUT_TOKENS=8192
MODEL_PROVIDER_TIMEOUT_SECONDS=120

# ---- 知识库嵌入/重排（阶段 2 向量检索；key 复用 MODEL_PROVIDER_API_KEY）----
# 嵌入: POST {base}/embeddings（1024 维）；重排: POST {base}/rerank（路径为 /rerank，/reranker 不支持）
MODEL_EMBEDDING_MODEL=
MODEL_RERANKER_MODEL=

# ---- turn 直连 relay（#18）----
TURN_DIRECT_RELAY=1

# ============================================================================
# ⚠️ 开发/演示用种子账号（identity/seed.py 幂等写入，仅空集合时）
# ============================================================================
# 首次启动时若 users/roles/role_bindings 为空，会自动创建下列账号与角色绑定，
# 使管理端开箱可用（否则登录后 roles 为空 → 管理端全 403）。
#
# 登录地址：POST /api/v1/auth/login  { "username": "...", "password": "..." }
#
#   管理员：admin / admin123      → /auth/me 返回 roles: ["admin"]，可进管理端
#   运维：  ops / ops12345        → roles: ["ops"]；能管工具+设备，用户/审计/模型 403
#   普通成员：member / member123  → 可登录，写操作 403
#
# 运维（ops）是**非 admin 的受限管理角色**，用于开箱演示阶段 2 验收项
# 「两个不同角色的用户，看到的模型/知识/工具集合不同」（00 §11）：
# 它能过 tool.manage / device.manage 的端点，但过不了 user.manage 等。
#
# 🔴 生产部署前必做其一：改掉这三个密码，或直接删除这三个账号。
#    阶段 1 的密码校验是**占位**（只判非空，未做 argon2id 哈希比对），
#    因此这些口令等同于明文——切勿在生产沿用。
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_OPS_USERNAME=ops
SEED_OPS_PASSWORD=
SEED_MEMBER_USERNAME=member
SEED_MEMBER_PASSWORD=

